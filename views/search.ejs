<!-- ejs 파일은 일반적으로 views 폴더에 생성 -->

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>list</title>
    <link rel="stylesheet" href="/main.css">
</head>

<body class="grey-bg">
    <!-- <%- include %>로 다른 ejs 파일을 포합 시킬 수 있음(자리에 해당 파일의 html 내용이 들어간다.) -->
    <!-- 변수를 전달도 가능 일반적으로 오브젝트로 전달 -->
    <%- include('nav.ejs',{age:20, name:'kim'}) %>
        <div class="white-bg">
            <!-- ejs에서 html 안에 js 내용 넣기! -->
            <!-- <% %> 태그 사용하기 -->
            <% for(let i=(page - 1) * 5; i < page * 5 && i < posts.length; i++){ %>
                <div class="list-box">
                    <!-- 서버에서 전송받은 데이터 html에서 사용하기! -->
                    <!-- <%= %> 태그 사용하기 -->
                    <h4>
                        <!-- 제목 누르면 해당 detail 페이지로 이동~ -->
                        <a href="/detail/<%=posts[i]._id%>">
                            <%= posts[i].title %>
                        </a>

                    </h4>
                    <p>
                        <%= posts[i].content %>
                    </p>
                </div>
                <% }%>
        </div>
        <div class="test-bg">
            <% for(let i=0; i < posts.length / 5; i ++){ %>
                <button onclick="MovePage('<%=i+1%>')">
                    <%=i + 1%>
                </button>
                <%}%>
        </div>
        <div>
            <input class="search-box" type="text" name="target">
            <button class="search-btn" type="submit">검색</button>
        </div>
</body>
<script>
    function MovePage(page) {
            window.location.href = `/search/?target=${'<%=target%>'}&page=${page}`;
    }
    document.querySelector('.search-btn').addEventListener('click', () => {
        let target = document.querySelector('.search-box').value;
        window.location.href = `/search/?target=${target}&page=1`
    })
</script>

</html>